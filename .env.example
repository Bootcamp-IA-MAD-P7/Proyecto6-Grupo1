# Copy to .env for Docker Compose and replace every placeholder locally.
# Never commit the resulting .env file.
POSTGRES_PASSWORD=replace-with-a-random-admin-password
CLAIMVOX_DB_APP_PASSWORD=replace-with-a-different-random-app-password
APP_JWT_SECRET=replace-with-a-random-signing-secret
APP_DEMO_USERNAME=replace-with-a-temporary-demo-username
APP_DEMO_PASSWORD=replace-with-a-random-demo-password
APP_DEMO_ROLE=admin
APP_DEMO_NAME=ClaimVox reviewer
