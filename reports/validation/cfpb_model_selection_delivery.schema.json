{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CFPB governed delivery model-selection evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "execution_manifest",
    "candidate",
    "cross_validation",
    "optimization",
    "trials",
    "per_class_metrics",
    "train_validation_macro_f1_gap",
    "confirmation_boundary"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "policy_version": { "type": "string", "minLength": 1 },
    "execution_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_scope",
        "partition_fingerprint",
        "package_versions",
        "random_state"
      ],
      "properties": {
        "execution_scope": { "const": "delivery" },
        "partition_fingerprint": { "type": "string", "minLength": 1 },
        "package_versions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "random_state": { "const": 42 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parameters"],
      "properties": {
        "name": { "enum": ["rf", "xgb", "lgbm"] },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": ["number", "integer", "string", "boolean"]
          }
        }
      }
    },
    "cross_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "group_column", "n_splits", "random_state"],
      "properties": {
        "strategy": { "const": "StratifiedGroupKFold" },
        "group_column": { "const": "narrative_hash" },
        "n_splits": { "const": 5 },
        "random_state": { "const": 42 }
      }
    },
    "optimization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_metric", "max_trials", "sampler_seed"],
      "properties": {
        "primary_metric": { "const": "macro_f1" },
        "max_trials": { "type": "integer", "minimum": 30 },
        "sampler_seed": { "const": 42 }
      }
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parameters",
          "fold_metrics",
          "train_macro_f1_mean",
          "train_macro_f1_std",
          "validation_macro_f1_mean",
          "validation_macro_f1_std",
          "execution_cost_seconds",
          "class_limitations"
        ],
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": ["number", "integer", "string", "boolean"]
            }
          },
          "fold_metrics": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "train_macro_f1",
                "validation_macro_f1",
                "class_limitations"
              ],
              "properties": {
                "train_macro_f1": { "type": "number", "minimum": 0, "maximum": 1 },
                "validation_macro_f1": { "type": "number", "minimum": 0, "maximum": 1 },
                "class_limitations": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "train_macro_f1_mean": { "type": "number", "minimum": 0, "maximum": 1 },
          "train_macro_f1_std": { "type": "number", "minimum": 0 },
          "validation_macro_f1_mean": { "type": "number", "minimum": 0, "maximum": 1 },
          "validation_macro_f1_std": { "type": "number", "minimum": 0 },
          "execution_cost_seconds": { "type": "number", "minimum": 0 },
          "class_limitations": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "per_class_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Checking or savings account",
        "Credit card",
        "Credit reporting or other personal consumer reports",
        "Debt collection",
        "Debt or credit management",
        "Money transfer, virtual currency, or money service",
        "Mortgage",
        "Payday loan, title loan, personal loan, or advance loan",
        "Prepaid card",
        "Student loan",
        "Vehicle loan or lease"
      ],
      "properties": {
        "Checking or savings account": { "$ref": "#/$defs/class_metrics" },
        "Credit card": { "$ref": "#/$defs/class_metrics" },
        "Credit reporting or other personal consumer reports": { "$ref": "#/$defs/class_metrics" },
        "Debt collection": { "$ref": "#/$defs/class_metrics" },
        "Debt or credit management": { "$ref": "#/$defs/class_metrics" },
        "Money transfer, virtual currency, or money service": { "$ref": "#/$defs/class_metrics" },
        "Mortgage": { "$ref": "#/$defs/class_metrics" },
        "Payday loan, title loan, personal loan, or advance loan": { "$ref": "#/$defs/class_metrics" },
        "Prepaid card": { "$ref": "#/$defs/class_metrics" },
        "Student loan": { "$ref": "#/$defs/class_metrics" },
        "Vehicle loan or lease": { "$ref": "#/$defs/class_metrics" }
      }
    },
    "train_validation_macro_f1_gap": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 0.05
    },
    "confirmation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reserved_partition",
        "used_for_selection",
        "used_for_retuning",
        "protected_test_used",
        "champion_declared"
      ],
      "properties": {
        "reserved_partition": { "const": "validation" },
        "used_for_selection": { "const": false },
        "used_for_retuning": { "const": false },
        "protected_test_used": { "const": false },
        "champion_declared": { "const": false }
      }
    }
  },
  "$defs": {
    "class_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precision", "recall", "f1", "support"],
      "properties": {
        "precision": { "type": "number", "minimum": 0, "maximum": 1 },
        "recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "f1": { "type": "number", "minimum": 0, "maximum": 1 },
        "support": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
